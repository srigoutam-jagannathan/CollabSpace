# Supabase — copy to .env.local and fill in your project values
# Never commit .env.local to source control

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Microsoft Entra ID (Azure AD) — configured inside Supabase Auth dashboard,
# these values are for reference only (not used directly in the client).
# AZURE_AD_CLIENT_ID=your-azure-app-client-id
# AZURE_AD_TENANT_ID=your-azure-tenant-id
